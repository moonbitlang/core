import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/simd",
}

// Non-cryptographic checksums over byte views. Independent of compression
// formats, I/O, and cancellation policies.

// simd is experimental; its import is used only by native/linear-wasm paths.

warnings = "-alert_experimental-unused_package"

import {
  "moonbitlang/core/test",
} for "test"

import {
  "moonbitlang/core/test",
} for "wbtest"

options(
  "allow-experimental-packages": [ "moonbitlang/core/simd" ],
)
