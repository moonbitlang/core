///|
test "whole matches agree with compile-time lexmatch" {
  let mut checks = 0
  for (pattern, results) in lexmatch_cases {
    let re = @string.Regex::unsafe_from_string(pattern)
    let expected = results.split(" ").collect()
    assert_eq(expected.length(), lexmatch_inputs.length())
    for i, input in lexmatch_inputs {
      let actual = match re.execute(input) {
        None => "-"
        Some(m) => "\{m.before().length()},\{m.content().length()}"
      }
      if actual != expected[i].to_owned() {
        fail(
          "/\{pattern}/ on \{input.escape()}: lexmatch \{expected[i]}, runtime \{actual}",
        )
      }
      checks += 1
    }
  }
  assert_eq(checks, 12480)
}
