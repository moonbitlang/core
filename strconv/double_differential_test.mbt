///|
test "parse: overflow, underflow and exponent boundaries" {
  inspect(
    batch(boundary_inputs),
    content=(
      #|1e308 => 0x7fe1ccf385ebc8a0 1e+308
      #|2e308 => value out of range
      #|1e309 => value out of range
      #|1e310 => value out of range
