import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async_io/internal/event_loop",
  "moonbitlang/core/async_io/internal/coroutine",
  "moonbitlang/core/async_io/internal/fd_util",
  "moonbitlang/core/internal/os_string",
  "moonbitlang/core/async_io/internal/c_buffer",
  "moonbitlang/core/async_io/stdio",
  "moonbitlang/core/async_io",
  "moonbitlang/core/async_io/io",
  "moonbitlang/core/async_io/fs",
  "moonbitlang/core/async_io/signal",
  "moonbitlang/core/async_io/os_error",
}

import {
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/async_io/fs",
  "moonbitlang/core/async_io/internal/test_util",
  "moonbitlang/core/encoding/utf8",
} for "test"

import {
  "moonbitlang/core/async_io/internal/test_util",
} for "wbtest"

max_concurrent_tests = 5
// workaround an upstream compiler bug temporarily

warnings = "-implicit_impl_as_method"

options(
  targets: {
    "deprecated.mbt": [ "native", "wasm" ],
    "process.mbt": [ "native", "wasm" ],
    "orphan_process.mbt": [ "native", "wasm" ],
    "unix.mbt": [ "native", "wasm" ],
    "windows.mbt": [ "native", "wasm" ],
    "wasm.mbt": [ "wasm" ],
    "basic_test.mbt": [ "native", "wasm" ],
    "cancel_test.mbt": [ "native", "wasm" ],
    "cancellation.mbt": [ "native", "wasm" ],
    "commands_for_test.mbt": [ "native", "wasm" ],
    "cwd_test.mbt": [ "native", "wasm" ],
    "env_test.mbt": [ "native", "wasm" ],
    "helper_test.mbt": [ "native", "wasm" ],
    "redirect.mbt": [ "native", "wasm" ],
    "redirect_test.mbt": [ "native", "wasm" ],
    "spawn_in_group_test.mbt": [ "native", "wasm" ],
    "wait_test.mbt": [ "native", "wasm" ],
  },
)
