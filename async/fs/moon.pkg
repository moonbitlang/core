import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/int",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/buffer",
  "moonbitlang/core/set",
  "moonbitlang/core/random",
  "moonbitlang/core/cmp",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/internal/event_loop",
  "moonbitlang/core/async/internal/fd_util",
  "moonbitlang/core/async/internal/env_util",
  "moonbitlang/core/async/internal/c_buffer",
  "moonbitlang/core/async",
  "moonbitlang/core/async/internal/coroutine",
  "moonbitlang/core/async/internal/errno_util",
}

import {
  "moonbitlang/core/async/internal/test_util",
} for "test"

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/test",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/async/process",
} for "test"

#cfg(target="native")
import {
  "moonbitlang/core/internal/os_string",
} for "test"

max_concurrent_tests = 3

options(
  "allow-experimental-packages": true,
  experimental: true,
  targets: {
    "README.mbt.md": [ "native" ],
