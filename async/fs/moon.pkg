    "eof_test.mbt": [ "native", "wasm" ],
    "file.mbt": [ "native", "wasm" ],
    "lock_test.mbt": [ "native", "wasm" ],
    "mkdir_test.mbt": [ "native", "wasm" ],
    "named_pipe_test.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "random_access_test.mbt": [ "native", "wasm" ],
    "read_all_test.mbt": [ "native", "wasm" ],
    "realpath_test.mbt": [ "native", "wasm" ],
    "rename_test.mbt": [ "native", "wasm" ],
    "stat_test.mbt": [ "native" ],
    "text_file_test.mbt": [ "native", "wasm" ],
    "timestamp.mbt": [ "native", "wasm" ],
    "timestamp_test.mbt": [ "native", "wasm" ],
    "tmpdir.mbt": [ "native" ],
    "tmpdir.wasm.mbt": [ "wasm" ],
    "tmpdir_test.mbt": [ "native", "wasm" ],
    "utils.mbt": [ "native", "wasm" ],
    "walk_test.mbt": [ "native", "wasm" ],
    "watch.mbt": [ "native", "wasm" ],
    "watch_inotify.mbt": [ "native", "wasm" ],
