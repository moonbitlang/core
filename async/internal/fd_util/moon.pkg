import {
  "moonbitlang/core/builtin",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/async/types",
  "moonbitlang/core/async/os_error",
}

#cfg(target="native")
import {
  "moonbitlang/core/ref",
  "moonbitlang/core/async/internal/env_util",
  "moonbitlang/core/internal/os_string",
}

options(
  "allow-experimental-packages": true,
  targets: {
    "deprecated.mbt": [ "native", "wasm" ],
    "fd_util.mbt": [ "native" ],
    "fd_util.wasm.mbt": [ "wasm" ],
    "pipe.mbt": [ "native" ],
    "pipe.wasm.mbt": [ "wasm" ],
    "stat.mbt": [ "native", "wasm" ],
  },
)
