  "moonbitlang/core/ref",
  "moonbitlang/core/debug",
  "moonbitlang/core/async/internal/event_loop",
  "moonbitlang/core/async/internal/coroutine",
  "moonbitlang/core/async/internal/env_util",
  "moonbitlang/core/async/internal/fd_util",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/internal/c_buffer",
}

import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
