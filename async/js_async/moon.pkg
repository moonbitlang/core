import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/ref",
  "moonbitlang/core/async/internal/coroutine",
  "moonbitlang/core/async/internal/event_loop",
  "moonbitlang/core/async/io",
}

import {
  "moonbitlang/core/test",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async",
} for "test"

options(
  "allow-experimental-packages": true,
  experimental: true,
  targets: {
    "js_async.mbt": [ "js" ],
    "js_async_test.mbt": [ "js" ],
    "readable_stream.mbt": [ "js" ],
    "readable_stream_test.mbt": [ "js" ],
    "unimplemented.mbt": [ "native", "wasm", "wasm-gc" ],
  },
)
