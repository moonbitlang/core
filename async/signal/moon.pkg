import {
  "moonbitlang/core/builtin",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/async/internal/event_loop",
}

import {
  "moonbitlang/core/async/internal/test_util",
} for "test"

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
} for "test"

options(
  "allow-experimental-packages": true,
  experimental: true,
  targets: {
    "deprecated.mbt": [ "native", "wasm" ],
    "signal.mbt": [ "native", "wasm" ],
    "signal_test.mbt": [ "native", "wasm" ],
  },
)
