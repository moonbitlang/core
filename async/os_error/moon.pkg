import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/json",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/async/internal/env_util",
  "moonbitlang/core/async/internal/errno_util" @errno,
}

import {
  "moonbitlang/core/async/internal/test_util",
} for "test"

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/test",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
} for "test"

options(
  "allow-experimental-packages": true,
  experimental: true,
  targets: {
    "error.mbt": [ "native", "wasm" ],
    "error_kind.mbt": [ "native", "wasm" ],
    "deprecated.mbt": [ "native", "wasm" ],
    "os_error_test.mbt": [ "native", "wasm" ],
  },
)
