options(
  experimental: true,
  "allow-experimental-packages": true,
)

import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/async/internal/fd_util",
  "moonbitlang/core/async/internal/event_loop",
  "moonbitlang/core/async/io",
}

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/internal/test_util",
  "moonbitlang/core/async/raw_fd/internal/raw_fd_test_util",
} for "test"

supported_targets = "-all+native"
