import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

#cfg(any(target="native", target="wasm", target="js"))
import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/tls",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/int",
  "moonbitlang/core/string",
  "moonbitlang/core/set",
  "moonbitlang/core/cmp",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/compress/gzip",
}

#cfg(target="js")
import {
  "moonbitlang/core/async/js_async",
}

import {
  "moonbitlang/core/async/internal/test_util",
} for "test"

#cfg(any(target="native", target="wasm", target="js"))
import {
  "moonbitlang/core/async",
} for "test"

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/test",
  "moonbitlang/core/async/fs",
} for "test"

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/async/internal/test_util",
} for "wbtest"

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/test",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/internal/bytes_util",
} for "wbtest"

options(
  "allow-experimental-packages": [ "moonbitlang/core/compress/gzip" ],
  targets: {
    "client.mbt": [ "native", "js", "wasm" ],
    "client_connection.js.mbt": [ "js" ],
    "client_connection.mbt": [ "native", "wasm" ],
    "client_test.mbt": [ "native", "js", "wasm" ],
    "cookie.mbt": [ "native", "js", "wasm" ],
    "cookie_wbtest.mbt": [ "native", "wasm" ],
    "parser.mbt": [ "native", "wasm" ],
    "parser_wbtest.mbt": [ "native", "wasm" ],
    "parser_trailer_wbtest.mbt": [ "native", "wasm" ],
    "proxy.mbt": [ "native", "js", "wasm" ],
    "proxy_test.mbt": [ "native", "wasm" ],
    "request.mbt": [ "native", "js", "wasm" ],
    "request_test.mbt": [ "native", "js", "wasm" ],
    "resolve_url_wbtest.mbt": [ "native", "wasm" ],
    "send.mbt": [ "native", "wasm" ],
    "send_wbtest.mbt": [ "native", "wasm" ],
    "server.mbt": [ "native", "wasm" ],
    "types.mbt": [ "native", "js", "wasm" ],
    "utils.mbt": [ "native", "js", "wasm" ],
  },
)
