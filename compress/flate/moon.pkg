options(
  experimental: true,
  "allow-experimental-packages": true,
)

import {
  "moonbitlang/core/builtin",
  "moonbitlang/core/debug",
  "moonbitlang/core/buffer",
  "moonbitlang/core/simd",
}

// Root package "@flate": the runtime-agnostic DEFLATE engine (RFC 1951).
// Pure, io-free, suspendable. gzip/zlib live in sibling packages that wrap it.

import {
  "moonbitlang/core/test",
  "moonbitlang/core/bench",
} for "wbtest"

// simd is experimental; its import is used only by native/linear-wasm paths.

warnings = "-alert_experimental-unused_package"

import {
  "moonbitlang/core/test",
  "moonbitlang/core/archive/zip",
} for "test"
