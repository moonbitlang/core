///|
test "zip rejects a lying zip64 size that exceeds the Int range" {
  try ignore(@zip.read(lying_zip64)) catch {
    ZipError(kind, _) =>
      match kind {
        UnsupportedFeature => ()
        _ => @test.fail("expected the lying size to be rejected")
      }
  } noraise {
    _ => @test.fail("expected the lying size to be rejected")
  }
}

///|
test "zip writes and reads back a zip64 trailer" {
  let archive = @zip.Archive()
  for i in 0..<65_536 {
    archive.add("e\{i}", b"", compression=Store)
  }
  let bytes = @zip.write(archive)
  let parsed = @zip.read(bytes)
  @test.assert_eq(parsed.entries().length(), 65_536)
}

///|
test "zip remove and replace" {
  let archive = @zip.Archive()
  archive.add("a.txt", b"a")
  archive.add("b.txt", b"b")
  @test.assert_eq(archive.remove("a.txt"), true)
  @test.assert_eq(archive.remove("missing"), false)
  @test.assert_eq(archive.get("a.txt"), None)
  @test.assert_eq(archive.replace("b.txt", b"bb"), true)
  @test.assert_eq(archive.replace("missing", b"x"), false)
  let parsed = @zip.read(@zip.write(archive))
  @test.assert_eq(parsed.entries().length(), 1)
  @test.assert_eq(parsed.get("b.txt"), Some(b"bb"))
}

///|
test "zip package-size limit" {
  try
    ignore(@zip.read(py_mini, limits=ReadLimits(max_package_bytes=50)))
  catch {
    ZipError(kind, _) =>
      match kind {
        LimitExceeded(PackageBytes, _, _) => ()
        _ => @test.fail("expected a package-size limit")
      }
  } noraise {
    _ => @test.fail("expected a package-size limit")
  }
}

///|
test "zip entry-count limit" {
  try ignore(@zip.read(py_mini, limits=ReadLimits(max_entries=0))) catch {
    ZipError(kind, _) =>
      match kind {
        LimitExceeded(Entries, _, _) => ()
        _ => @test.fail("expected an entry-count limit")
      }
  } noraise {
    _ => @test.fail("expected an entry-count limit")
  }
}

///|
test "zip per-entry and total uncompressed limits" {
  for compression in [@zip.Store, Deflate] {
    let archive = @zip.Archive()
    archive.add("first", b"abc", compression~)
    archive.add("second", b"def", compression~)
    let bytes = @zip.write(archive)
    let parsed = @zip.read(
      bytes,
      limits=ReadLimits(
        max_entry_uncompressed_bytes=3,
        max_total_uncompressed_bytes=6,
      ),
    )
    @test.assert_eq(parsed.get("first"), Some(b"abc"))
    @test.assert_eq(parsed.get("second"), Some(b"def"))
    let ZipError(kind, _) = @test.expect_error(() => {
      @zip.read(bytes, limits=ReadLimits(max_entry_uncompressed_bytes=2))
    })
    guard kind is LimitExceeded(EntryUncompressedBytes, _, _) else {
      @test.fail("expected the per-entry limit")
    }
    let ZipError(kind, _) = @test.expect_error(() => {
      @zip.read(bytes, limits=ReadLimits(max_total_uncompressed_bytes=5))
    })
    guard kind is LimitExceeded(TotalUncompressedBytes, _, _) else {
      @test.fail("expected the cumulative limit")
    }
  }
}

///|
test "zip directory-byte limit" {
  let reader = @zip.DirectoryReader(
    py_mini.length().to_uint64(),
    limits=DirectoryLimits(max_directory_bytes=10UL),
  )
  ignore(reader.advance(b""))
  try ignore(reader.advance(py_mini)) catch {
    ZipError(kind, _) =>
      match kind {
        LimitExceeded(DirectoryBytes, _, _) => ()
        _ => @test.fail("expected a directory-byte limit")
      }
  } noraise {
    _ => @test.fail("expected a directory-byte limit")
  }
}

///|
test "zip read honours cancellation" {
  try ignore(@zip.read(py_mini, cancelled=() => true)) catch {
    ZipError(kind, _) =>
      match kind {
        Cancelled => ()
        _ => @test.fail("expected cancellation")
      }
  } noraise {
    _ => @test.fail("expected cancellation")
  }
}

///|
test "zip write with max_output_bytes matches write and rejects oversize" {
  let archive = @zip.Archive()
  archive.add("a.txt", b"limited output payload")
  let exact = @zip.write(archive)
  @test.assert_eq(@zip.write(archive, max_output_bytes=exact.length()), exact)
  try ignore(@zip.write(archive, max_output_bytes=exact.length() - 1)) catch {
    ZipError(kind, _) =>
      match kind {
        LimitExceeded(OutputBytes, _, _) => ()
        _ => @test.fail("expected an output limit")
      }
  } noraise {
    _ => @test.fail("expected an output limit")
  }
}

///|
test "zip rejects non-archive input" {
  try ignore(@zip.read(b"not a zip archive at all")) catch {
    ZipError(kind, _) =>
      match kind {
        MissingEndOfCentral => ()
        _ => @test.fail("expected MissingEndOfCentral")
      }
  } noraise {
    _ => @test.fail("expected MissingEndOfCentral")
  }
}

///|
test "zip rejects corrupted fields with the correct error category" {
  let archive = @zip.Archive()
  archive.add("a.txt", b"abc", compression=Store)
  let valid = @zip.write(archive)
  @test.assert_eq(@zip.read(valid).get("a.txt"), Some(b"abc"))
  // Stored payload starts after the 30-byte local header and five-byte name.
  let central = 38
  @test.assert_eq(valid[central:central + 4], b"PK\x01\x02")
  let cases : Array[(Array[(Int32, Byte)], @zip.ZipErrorKind)] = [
    ([(0, b'\x00')], InvalidSignature),
    ([(6, b'\x01'), (central + 8, b'\x01')], UnsupportedFeature),
    ([(6, b'\x10'), (central + 8, b'\x10')], UnsupportedFeature),
    ([(8, b'\x63'), (central + 10, b'\x63')], UnsupportedCompression(99)),
    ([(30, b'\xFF'), (central + 46, b'\xFF')], InvalidUtf8),
    ([(35, b'z')], ChecksumMismatch),
    ([(22, b'\x05'), (central + 24, b'\x05')], SizeMismatch),
  ]
  for (changes, expected) in cases {
    let damaged = valid.to_fixedarray()
    for (at, byte) in changes {
      damaged[at] = byte
    }
    let ZipError(kind, _) = @test.expect_error(() => {
      @zip.read(Bytes::from_array(damaged))
    })
    @test.assert_eq(kind, expected)
  }
}

///|
// Python zipfile Deflate entry x=0123456789 (2020-01-01), followed by a
// ZIP64 EOCD/locator carrying the same counts and bounds as the classic EOCD.
// Python zipfile independently accepts and decodes the complete archive.
let optional_zip64 : Bytes = [
  0x50, 0x4B, 0x03, 0x04, 0x14, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x21, 0x50,
  0xC6, 0xC7, 0x84, 0xA6, 0x0C, 0x00, 0x00, 0x00, 0x0A, 0x00, 0x00, 0x00, 0x01, 0x00,
  0x00, 0x00, 0x78, 0x33, 0x30, 0x34, 0x32, 0x36, 0x31, 0x35, 0x33, 0xB7, 0xB0, 0x04,
  0x00, 0x50, 0x4B, 0x01, 0x02, 0x14, 0x03, 0x14, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00,
  0x00, 0x21, 0x50, 0xC6, 0xC7, 0x84, 0xA6, 0x0C, 0x00, 0x00, 0x00, 0x0A, 0x00, 0x00,
  0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80,
  0x01, 0x00, 0x00, 0x00, 0x00, 0x78, 0x50, 0x4B, 0x06, 0x06, 0x2C, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x2D, 0x00, 0x2D, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x2F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2B, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x50, 0x4B, 0x06, 0x07, 0x00, 0x00, 0x00, 0x00,
  0x5A, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x50, 0x4B,
  0x05, 0x06, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x2F, 0x00, 0x00, 0x00,
  0x2B, 0x00, 0x00, 0x00, 0x00, 0x00,
]

///|
test "optional ZIP64 end records preserve ordinary classic fields" {
  let archive = @zip.read(optional_zip64)
  @test.assert_eq(archive.get("x"), Some(b"0123456789"))
  @test.assert_eq(@zip.write(archive, preserve=true), optional_zip64)
  let end = optional_zip64.length() - 22
  let locator = end - 20
  // Invalid locator signature, conflicting entry count, and bad ZIP64 offset.
  for offset in [locator, end + 10, locator + 8] {
    let bytes = optional_zip64.to_array()
    bytes[offset] = b'\xff'
    let ZipError(_, _) = @test.expect_error(() => {
      @zip.read(Bytes::from_array(bytes))
    })
  }
}

///|
test "optional ZIP64 trailers remain consistent after removal and replacement" {
  let replacement = Bytes::make(1000, b'x')
  for remove in [true, false] {
    let archive = @zip.read(optional_zip64)
    if remove {
      @test.assert_eq(archive.remove("x"), true)
    } else {
      @test.assert_eq(archive.replace("x", replacement), true)
    }
    let rewritten = @zip.write(archive, preserve=true)
    let end = rewritten.length() - 22
    // Retain the optional ZIP64 records and non-sentinel classic counts.
    @test.assert_eq(rewritten[end - 76:end - 72], b"PK\x06\x06")
    let count = if remove { 0 } else { 1 }
    @test.assert_eq(zip_test_field(rewritten, end + 8, 2), count)
    @test.assert_eq(zip_test_field(rewritten, end + 10, 2), count)
    let reparsed = @zip.read(rewritten)
    @test.assert_eq(reparsed.entries().length(), count)
    let source = archive_range_source(rewritten)
    let directory = drive_directory_ranges(
      DirectoryReader(rewritten.length().to_uint64()),
      source,
    )
    @test.assert_eq(directory.entries().length(), count)
    if !remove {
      @test.assert_eq(reparsed.get("x"), Some(replacement))
      @test.assert_eq(
        drive_entry_ranges(directory.open_entry(0), source, 37),
        replacement,
      )
    }
  }
}

///|
test "ZIP writes round-trip at the 65535-entry sentinel boundary" {
  let archive = @zip.Archive()
  for _ in 0..<65534 {
    archive.add("x", b"", compression=Store)
  }
  let classic = @zip.write(archive)
  let parsed = @zip.read(classic)
  @test.assert_eq(parsed.entries().length(), 65534)
  parsed.add("last", b"", compression=Store)
  // Cover fresh serialization and promotion of a preserved classic trailer.
  for preserve in [false, true] {
    let bytes = @zip.write(parsed, preserve~)
    @test.assert_eq(@zip.read(bytes).entries().length(), 65535)
    let directory = drive_directory_ranges(
      DirectoryReader(bytes.length().to_uint64()),
      archive_range_source(bytes),
    )
    @test.assert_eq(directory.entries().length(), 65535)
    @test.assert_eq(directory.entries()[65534].name(), "last")
  }
}

///|
test "ZIP equality methods can be passed as functions across packages" {
  let limit_equal = @zip.LimitKind::equal
  @test.assert_eq(limit_equal(Entries, Entries), true)
  @test.assert_eq(limit_equal(Entries, OutputBytes), false)
  let error_equal = @zip.ZipErrorKind::equal
  @test.assert_eq(
    error_equal(
      LimitExceeded(TotalUncompressedBytes, 10UL, 15UL),
      LimitExceeded(TotalUncompressedBytes, 10UL, 15UL),
    ),
    true,
  )
  @test.assert_eq(
    error_equal(
      LimitExceeded(TotalUncompressedBytes, 10UL, 15UL),
      LimitExceeded(TotalUncompressedBytes, 10UL, 16UL),
    ),
    false,
  )
  let compression_equal = @zip.Compression::equal
  @test.assert_eq(compression_equal(Store, Store), true)
  @test.assert_eq(compression_equal(Store, Deflate), false)
}
